# GnuPG runtime and secret material must never enter this repository.
.gnupg/private-keys-v1.d/
.gnupg/openpgp-revocs.d/
.gnupg/public-keys.d/
.gnupg/crls.d/
.gnupg/*.kbx
.gnupg/*.kbx~
.gnupg/*.gpg
.gnupg/*.lock
.gnupg/S.*
.gnupg/random_seed
.gnupg/trustdb.gpg
.gnupg/sshcontrol

# Local setup state.
.setup.local
*.bak
__pycache__/
config/vicinae/passwords/node_modules/
config/vicinae/passwords/vicinae-env.d.ts
config/vicinae/passwords/assets/pass-cli.cjs
